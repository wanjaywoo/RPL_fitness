{
  "name": "fitstreak",
  "version": "1.0.0",
  "description": "Progressive Web App untuk menghitung kebutuhan kalori dengan rumus Mifflin-St Jeor dan melacak streak olahraga",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --verbose --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js"
  },
  "keywords": [
    "pwa",
    "fitness",
    "calorie-tracker",
    "streak",
    "mifflin-st-jeor"
  ],
  "author": "Rizwan Defriansyah",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
